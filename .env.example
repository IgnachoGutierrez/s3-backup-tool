# ---- AWS / S3 ----
# Name of the AWS CLI profile used to upload backups to S3.
AWS_PROFILE_NAME=
# Target S3 bucket that will receive the .bak files.
S3_BUCKET=

# ---- SQL Server connection ----
# SQL Server host or instance to connect to (e.g. localhost or myserver\SQLEXPRESS).
SERVER=
# Name of the database to back up.
DB=
# SQL Server login username.
DB_USER=
# SQL Server login password.
DB_PASSWORD=
# ODBC driver name, e.g. "ODBC Driver 18 for SQL Server".
DRIVER=
# Set to "yes" to trust a self-signed server certificate. Allowed: yes | no (default: no).
DB_TRUST_SERVER_CERT=no

# ---- Backup paths ----
# Directory ON THE SQL SERVER HOST where the .bak file is written by BACKUP DATABASE.
BACKUP_DIR=
# Path to the same .bak file as seen by the machine running this tool.
# Optional: defaults to BACKUP_DIR when left blank.
HOST_BACKUP_DIR=